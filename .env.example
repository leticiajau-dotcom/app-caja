# Credenciales OAuth de Google (Google Cloud Console > APIs & Servicios > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Se completan solos la primera vez, desde la pantalla /conectar.
# Después de crear la planilla, copiá esos dos valores acá:
GOOGLE_SHEET_ID=
GOOGLE_REFRESH_TOKEN=

# URL pública de la app (usada por NextAuth para el redirect de Google).
# En desarrollo: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Clave secreta para firmar las cookies de sesión de NextAuth.
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Clave secreta para firmar la sesión interna (usuario + PIN).
# Generar con: openssl rand -base64 32
SESSION_SECRET=
